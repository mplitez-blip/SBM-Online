# Application
NODE_ENV=staging
HOST=0.0.0.0
PORT=3000
APP_URL=https://sbm.bnahs.org

# PostgreSQL connection used inside Docker Compose
SQL_HOST=database
SQL_PORT=5432
SQL_USER=sbm_app
SQL_PASSWORD=
SQL_DB_NAME=sbm_region8

# PostgreSQL container initialization
POSTGRES_USER=sbm_app
POSTGRES_PASSWORD=
POSTGRES_DB=sbm_region8

# Authentication
JWT_SECRET=

# Optional integrations
GEMINI_API_KEY=
FIREBASE_AUTH_ENABLED=false

# Development seeding must remain disabled
ALLOW_DEVELOPMENT_SEED=false
